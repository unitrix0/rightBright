<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:rightBright.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:rightBright.Localization"
        xmlns:viewModels="clr-namespace:rightBright.ViewModels"
        xmlns:views="clr-namespace:rightBright.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
        x:Class="rightBright.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/app_icon_new.ico"
        Title="rightBright"
        Width="1000" Height="620"
        Background="{DynamicResource SurfaceBase}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="330,*" Margin="16">
        <views:MainViewSideBar Margin="0,0,16,0" />

        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Border Classes="card"
                    Padding="{DynamicResource PaddingCard}"
                    Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Classes="caption" Margin="0,0,0,4"
                               Text="{x:Static localization:Texts.MainSensorLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="0"
                              HorizontalAlignment="Stretch" Margin="0,0,8,0"
                              ItemsSource="{Binding AvailableSensors}"
                              SelectedItem="{Binding SelectedSensor}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Row="1" Grid.Column="1"
                            Command="{Binding ConnectSensorCommand}"
                            Content="{x:Static localization:Texts.MainConnectButton}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="card">
                <ContentControl Content="{Binding CurrentContent}" />
            </Border>
        </Grid>

    </Grid>

</Window>
