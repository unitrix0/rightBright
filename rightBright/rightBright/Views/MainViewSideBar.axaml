<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:rightBright.Localization"
             xmlns:viewModels="clr-namespace:rightBright.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="450"
             x:Class="rightBright.Views.MainViewSideBar"
             x:DataType="viewModels:MainWindowViewModel">
    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Classes="title" VerticalAlignment="Center"
                       Text="{x:Static localization:Texts.SidebarScreens}" />
            <Button Grid.Column="1"
                    Classes="iconButton"
                    Command="{Binding DetectMonitorsCommand}"
                    ToolTip.Tip="{x:Static localization:Texts.SidebarDetectMonitorsTooltip}"
                    IsVisible="{Binding IsNotLoadingDisplays}">
                <TextBlock Classes="icon regular" Text="&#xE096;" />
            </Button>
        </Grid>

        <TextBlock Grid.Row="1"
                   Classes="body"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center"
                   Margin="0,16"
                   IsVisible="{Binding ApplicationViewModel.IsLoadingDisplays, TargetNullValue=false, FallbackValue=false}"
                   Text="{x:Static localization:Texts.SidebarSearchingMonitors}" />

        <ListBox Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemsSource="{Binding Displays}"
                 SelectedItem="{Binding SelectedScreenItem}"
                 IsVisible="{Binding IsNotLoadingDisplays}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <!-- The card carries the selection colour, so the item chrome stays invisible. -->
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <Style Selector="Border.screenCard">
                    <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover Border.screenCard">
                    <Setter Property="Background" Value="{DynamicResource PrimarySubtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                </Style>
                <Style Selector="ListBoxItem:selected Border.screenCard">
                    <Setter Property="Background" Value="{DynamicResource PrimarySelected}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimarySelected}" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover Border.screenCard">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHover}" />
                </Style>
                <Style Selector="ListBoxItem:selected Border.screenCard TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="screenCard" Padding="10">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                       Classes="icon lg"
                                       Margin="0,0,10,0"
                                       Text="&#xE32E;" />

                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Classes="body strong"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ModelName}" />

                            <Grid Grid.Column="1" Grid.Row="1"
                                  ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="icon sm" Text="&#xE472;" />
                                    <TextBlock Classes="caption" VerticalAlignment="Center"
                                               Text="{Binding LastBrightnessSet, StringFormat='{}{0}%'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Classes="caption"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding DeviceName}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Classes="card"
                Padding="{DynamicResource PaddingCard}"
                Margin="0,4,0,0">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                           Classes="icon lg"
                           Foreground="{DynamicResource Primary}"
                           Margin="0,0,12,0"
                           Text="&#xE610;" />

                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*"
                      ToolTip.Tip="{Binding SelectedSensor.FriendlyName, TargetNullValue='', FallbackValue=''}">
                    <TextBlock Classes="body strong" Margin="0,0,4,0"
                               Text="{x:Static localization:Texts.SidebarSensorLabel}" />
                    <TextBlock Grid.Column="1"
                               Classes="body"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedSensor.FriendlyName, TargetNullValue='', FallbackValue=''}" />
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="{x:Static localization:Texts.SidebarMinLabel}" />
                        <TextBlock Classes="caption strong"
                                   Text="{Binding SelectedSensor.MinValue, TargetNullValue=0, FallbackValue=0}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="{x:Static localization:Texts.SidebarCurrentLabel}" />
                        <TextBlock Classes="caption strong"
                                   Text="{Binding SelectedSensor.CurrentValue, TargetNullValue=0, FallbackValue=0}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="{x:Static localization:Texts.SidebarMaxLabel}" />
                        <TextBlock Classes="caption strong"
                                   Text="{Binding SelectedSensor.MaxValue, TargetNullValue=0, FallbackValue=0}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Classes="cardWarning"
                Margin="0,12,0,0"
                Padding="{DynamicResource PaddingCard}"
                IsVisible="{Binding ApplicationViewModel.IsUpdateAvailable}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                           Classes="icon lg"
                           Margin="0,0,12,0"
                           Text="&#xE390;" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Classes="body strong"
                           TextWrapping="Wrap"
                           Text="{Binding ApplicationViewModel.AvailableUpdateVersionText}" />
                <Button Grid.Row="1" Grid.Column="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ApplicationViewModel.InstallAvailableUpdateCommand}"
                        Content="{x:Static localization:Texts.SidebarInstallUpdateButton}" />
            </Grid>
        </Border>

        <Button Grid.Row="5"
                Classes="iconButton"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="{x:Static localization:Texts.SettingsTitle}">
            <TextBlock Classes="icon" Text="&#xE270;" />
        </Button>
    </Grid>
</UserControl>
